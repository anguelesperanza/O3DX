; vshader.v.pica — per-vertex colour shader shared with Triangle-Example.
;
; Uniform:  projection[4]  — 4×4 orthographic projection matrix
;
; Inputs:
;   v0 — position (x, y, z)   — 3 floats; GPU pads w=1.0 automatically
;   v1 — color    (r, g, b, a) — 4 floats; passed through unchanged
;
; Outputs:
;   out0 — clip-space position  (projected)
;   out1 — primary vertex color (pass-through, including alpha)

.fvec projection[4]

.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias ones myconst.yyyy

.alias vtxpos v0
.alias vtxclr v1

.out out0 position
.out out1 color

.proc main
    mov r0,   vtxpos
    mov r0.w, ones

    dp4 out0.x, projection[0], r0
    dp4 out0.y, projection[1], r0
    dp4 out0.z, projection[2], r0
    dp4 out0.w, projection[3], r0

    ; Alpha is in vtxclr.w — pass through unchanged for blending.
    mov out1, vtxclr

    end
.end
